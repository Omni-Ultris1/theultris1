NODE_ENV=development
PORT=5000
API_VERSION=v1
APP_NAME=ULTRIS1
CLIENT_URL=http://localhost:3000
MONGODB_URI=mongodb://localhost:27017/ultris1
MONGODB_URI_TEST=mongodb://localhost:27017/ultris1_test
JWT_SECRET=dev-jwt-secret-key-change-in-production-must-be-32-chars
JWT_REFRESH_SECRET=dev-jwt-refresh-secret-key-change-in-production-32-chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_ROUNDS=10
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=10
LOG_LEVEL=debug
LOG_FILE=logs/app.log
